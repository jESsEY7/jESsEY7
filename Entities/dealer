{
  "name": "Dealer",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string",
      "description": "Dealership name"
    },
    "owner_email": {
      "type": "string",
      "description": "Owner's email address"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "license_number": {
      "type": "string",
      "description": "Dealer license number"
    },
    "tax_id": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected",
        "suspended"
      ],
      "default": "pending"
    },
    "verification_date": {
      "type": "string",
      "format": "date"
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "reviews_count": {
      "type": "number",
      "default": 0
    },
    "total_sales": {
      "type": "number",
      "default": 0
    },
    "active_listings": {
      "type": "number",
      "default": 0
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "business_name",
    "owner_email"
  ]
}